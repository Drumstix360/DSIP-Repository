# Create a custom type which is collection of three numbers
type savings start
number [ 3 ]
end


# savings account
type client start
var name is text
var bank_numbers is savings
var balance is number
end


# declare and initialize a variable to store the savings
var my_savings is savings
my_savings -> savings ( 1000 , 15000 , 932 )


# Create a new variable to store the sum of my savings
var total_savings is number

# calculate the total savings using plus and indexing
total_savings -> my_savings [ 0 ] + my_savings [ 1 ] + my_savings [ 2 ]

# declare and initialize a variable to store the bank account
var bank_account is client
bank_account -> client ( " Test " , my_savings , total_savings )

# print the result
print ( " My back account details : " , bank_account )